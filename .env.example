# The demo does not require an AI provider key.
APP_ENV=development
# Local single-user storage. Keep this directory private and outside version control.
YIDUO_PRIVATE_DIR=private_data
# Optional AI teaching assistant. Never commit a real key.
# DeepSeek is the default provider when this key is present.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# OpenAI remains available as a fallback when DEEPSEEK_API_KEY is empty.
OPENAI_API_KEY=
YIDUO_OPENAI_MODEL=gpt-5-mini

# Shared daily AI attempt limit; 0 disables paid requests. Resets at UTC+8 midnight.
YIDUO_AI_DAILY_LIMIT=20
